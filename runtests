#!/usr/bin/env python3
"""Run reviewed Jest and browser test commands."""

import os
import sys

from openwisp_utils.test.runner import (
    InvalidTestArgument,
    compile_test_file_pattern,
    parse_test_files,
)


def main():
    pattern = compile_test_file_pattern(
        ("client", "server", "config", "browser-test"), kind="jest"
    )
    try:
        files, flags = parse_test_files(
            sys.argv[1:],
            pattern,
            ("--coverage", "--es5", "--browser", "--runInBand"),
        )
        modes = [flag for flag in flags if flag != "--runInBand"]
        if len(modes) > 1:
            raise InvalidTestArgument(f"Unsupported test argument: {modes[1]}")
        mode = modes[0] if modes else ""
        if files and mode:
            raise InvalidTestArgument(
                "Unsupported test arguments: select files without a CI mode"
            )
        paths = [match.group(0) for match in files]
        if any(path.startswith("browser-test/") for path in paths):
            raise InvalidTestArgument(
                "Unsupported test argument: use --browser for browser tests"
            )
    except InvalidTestArgument as error:
        print(error, file=sys.stderr)
        return 2
    runner_flags = [flag for flag in flags if flag == "--runInBand"]
    if paths:
        arguments = ["jest", "--runTestsByPath", *paths, *runner_flags]
    else:
        command = {
            "": "test",
            "--coverage": "coverage",
            "--es5": "test-es5",
            "--browser": "browser-test",
        }
        arguments = [command[mode], *runner_flags]
    os.execvp("yarn", ["yarn", *arguments])


if __name__ == "__main__":
    sys.exit(main())
