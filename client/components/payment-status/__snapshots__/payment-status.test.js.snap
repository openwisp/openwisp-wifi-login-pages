exports[`Test <PaymentStatus /> cases should render draft correctly 1`] = `
<div
  className="container content"
>
  <div
    className="inner"
  >
    <div
      className="main-column single"
    >
      <div
        className="inner"
      >
        <h2
          className="row"
        >
          Payment required to proceed
        </h2>
        <div
          className="row payment-instructions"
          dangerouslySetInnerHTML={
            {
              "__html": "<p>You have <strong>10 minutes</strong> to complete your payment. Make sure you're ready before proceeding.</p><p>Copy the payment link below. If this window closes, you can paste the link into your browser to continue.</p>",
            }
          }
          id="payment-link-help"
        />
        <div
          className="row payment-link"
        >
          <div
            className="payment-link-control"
          >
            <input
              aria-describedby="payment-link-help"
              aria-label="PAY_LINK_LBL"
              className="input payment-link-input"
              id="payment-link"
              onClick={[Function]}
              readOnly={true}
              title="PAY_LINK_COPY_HINT"
              type="text"
              value="https://wifi.example.com/default/login?n=pay&sid=secret"
            />
            <button
              aria-label="PAY_LINK_COPY_BTN"
              className="button partial payment-link-copy"
              onClick={[Function]}
              type="button"
            >
              <span
                aria-hidden="true"
                className="payment-link-copy-icon"
              />
              <span
                className="payment-link-copy-label"
              >
                PAY_LINK_COPY_BTN
              </span>
            </button>
          </div>
        </div>
        <div
          className="row payment-instructions"
          dangerouslySetInnerHTML={
            {
              "__html": "<p>If you run out of time, log in again to retry. You have up to <strong>3 attempts</strong>.</p>",
            }
          }
        />
        <div
          className="row"
        >
          <Link
            className="button full"
            onClick={[Function]}
            to="/default/status"
          >
            Proceed with the payment
          </Link>
        </div>
        <div
          className="row"
        >
          <button
            className="button full"
            onClick={[Function]}
            type="button"
          >
            Cancel operation and log out
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

